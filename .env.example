# Local defaults only. Replace every password, JWT secret and API key before any shared deployment.
POSTGRES_PASSWORD=changeme
JWT_SECRET=change-this-long-random-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
API_PORT=8000
FRONTEND_PORT=3000
DVWA_PORT=8081
MOCK_HTTP_PORT=18000
MOCK_K8S_PORT=16443
AUTHORIZED_SCOPE=dvwa,127.0.0.1,localhost
# Presets remain available for authenticated scans. Targets without a preset
# can use auth_ref=none after confirming authorization in the UI.
AUTHORIZATION_FILE=auth.example.yaml
MAX_RPS=5
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:2.17.0
ZAP_HOST=zap
ZAP_PORT=8090
ZAP_API_KEY=local-zap-key
# The DVWA credentials below are for the isolated lab profile only.
DVWA_USERNAME=admin
DVWA_PASSWORD=password
# Local OWASP Juice Shop account for authenticated lab scans.
JUICE_EMAIL=
JUICE_PASSWORD=
OPENVAS_ENABLED=false
OPENVAS_SKIP_SYNC=false
OPENVAS_IMAGE=immauss/openvas:26.07.27.01
OPENVAS_USERNAME=admin
OPENVAS_PASSWORD=admin
NUCLEI_TAGS=spring,exposure,misconfiguration,default-login
NUCLEI_SEVERITY=high,critical
NUCLEI_MAX_TARGETS=3
LAB_BENCHMARK_ENABLED=true
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BATCH_SIZE=6
LLM_MAX_TOKENS=4096
OAST_PORT=18001
OAST_SECRET=local-oast-secret
OAST_PUBLIC_BASE_URL=http://oast:8001
WEAK_CREDENTIALS_FILE=config/weak_credentials.txt
EVIDENCE_RETENTION_DAYS=30
VITE_API_URL=

# Optional external VAS launcher. Use an absolute path to an .exe/.cmd/.bat/.ps1
# file, or an http(s) URL. VAS_STOPPER is optional when the launcher can be
# stopped by the PID tracked by the start script.
VAS_LAUNCHER=
VAS_STOPPER=
